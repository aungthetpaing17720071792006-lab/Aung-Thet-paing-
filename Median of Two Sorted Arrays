class Solution {
public:
    double findMedianSortedArrays(vector<int>& nums1, vector<int>& nums2) {

        vector<int> arr;

        for (int x : nums1) {
            arr.push_back(x);
        }

        for (int x : nums2) {
            arr.push_back(x);
        }

        sort(arr.begin(), arr.end());

        int size = arr.size();

        if (size % 2 == 1) {
            return arr[size / 2];
        }

        return (arr[size / 2 - 1] + arr[size / 2]) / 2.0;
    }
};
